rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User private profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User private journals and settings
    match /users/{userId}/journals/{journalId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /users/{userId}/settings/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/monthly_records/{recordId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Direct collection & Cross-Application Sharing (GitHub Pages & Cloud Run)
    match /journals/{journalId} {
      allow read, write: if request.auth != null;
    }

    match /shared_journals/{journalId} {
      allow read, write: if request.auth != null;
    }

    match /settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
